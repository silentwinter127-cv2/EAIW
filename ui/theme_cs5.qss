/* EAIW 1.0 - 2008-2015 Professional Digital Imaging Workstation Theme (CS5 / Nuke Dark Slate) */
QMainWindow, QDialog, QWidget {
    background-color: #2b2b2b;
    color: #d8d8d8;
    font-family: "Segoe UI", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
    font-size: 12px;
}
QGroupBox {
    background-color: #333333;
    border: 1px solid #1e1e1e;
    border-top: 1px solid #484848;
    margin-top: 14px;
    padding: 8px;
    font-weight: bold;
    color: #e6a82e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    background-color: #242424;
    border: 1px solid #454545;
}
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a4a4a, stop:1 #353535);
    border: 1px solid #1b1b1b;
    border-top: 1px solid #5c5c5c;
    color: #e4e4e4;
    padding: 5px 10px;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #525252;
    border-color: #e6a82e;
}
QPushButton:pressed {
    background-color: #262626;
}
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1f1f1f;
    border: 1px solid #444444;
    color: #dcdcdc;
    padding: 3px 6px;
}
QTabWidget::pane {
    border: 1px solid #1c1c1c;
    background: #303030;
}
QTabBar::tab {
    background: #252525;
    border: 1px solid #191919;
    padding: 6px 12px;
    color: #aaaaaa;
}
QTabBar::tab:selected {
    background: #3a3a3a;
    color: #f0b43c;
    border-top: 2px solid #e6a82e;
}
QTableWidget, QListWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252525;
    gridline-color: #333333;
    color: #d4d4d4;
    border: 1px solid #141414;
}
QHeaderView::section {
    background-color: #383838;
    color: #dcdcdc;
    border: 1px solid #222222;
    padding: 4px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #1a1a1a;
    border: 1px solid #3c3c3c;
}
QSlider::handle:horizontal {
    background: #e6a82e;
    border: 1px solid #111111;
    width: 12px;
    margin: -5px 0;
}
